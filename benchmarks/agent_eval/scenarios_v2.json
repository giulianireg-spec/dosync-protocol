  "scenarios": [
    {
      "id": "N1",
      "env": "home",
      "phrase": "We're going to bed. Turn off all the lights in the house.",
      "expected": {
        "light-zone1-01": "turn_off",
        "light-zone1-02": "turn_off",
        "light-zone2-01": "turn_off",
        "light-zone2-02": "turn_off",
        "light-zone3-01": "turn_off",
        "light-zone3-02": "turn_off",
        "light-zone4-01": "turn_off",
        "light-zone4-02": "turn_off",
        "light-zone5-01": "turn_off",
        "light-zone6-01": "turn_off",
        "bridged-light-01": "turn_off"
      },
      "_note": "Every light, including the bridged one; nothing else (the TVs and the appliance switch are not lights)."
    },
    {
      "id": "N2",
      "env": "home",
      "phrase": "Dim the living room lights to 30 percent.",
      "expected": {
        "light-zone3-01": "set_brightness",
        "light-zone3-02": "set_brightness",
        "light-zone4-01": "set_brightness",
        "light-zone4-02": "set_brightness"
      },
      "params": {
        "brightness": 30
      }
    },
    {
      "id": "N3",
      "env": "home",
      "phrase": "Show 'Dinner is ready' on the TVs.",
      "expected": {
        "bridged-mediaplayer-01": "display",
        "bridged-mediaplayer-02": "display"
      },
      "_note": "The TVs only; an SMS to the phone is not what was asked."
    },
    {
      "id": "N4",
      "env": "home",
      "phrase": "There's a fire in the bedroom! Get everyone out of the house.",
      "expected": {
        "alarm-01": "alarm",
        "notifier-01": "notify",
        "light-zone1-01": "turn_on",
        "light-zone1-02": "turn_on",
        "light-zone2-01": "turn_on",
        "light-zone2-02": "turn_on",
        "light-zone3-01": "turn_on",
        "light-zone3-02": "turn_on",
        "light-zone4-01": "turn_on",
        "light-zone4-02": "turn_on",
        "light-zone5-01": "turn_on",
        "light-zone6-01": "turn_on"
      },
      "_note": "Whole house: sound the alarm, notify, light every room for evacuation."
    },
    {
      "id": "N5",
      "env": "plant",
      "phrase": "A technician needs to get into cell 2 for maintenance. Let them in.",
      "expected": {
        "lock-cell2-01": "unlock"
      }
    },
    {
      "id": "N6",
      "env": "plant",
      "phrase": "Maintenance in cell 2 is finished. Secure the cell.",
      "expected": {
        "lock-cell2-01": "lock"
      }
    },
    {
      "id": "N7",
      "env": "plant",
      "phrase": "Fire on floor 2! Get everyone out safely.",
      "expected": {
        "andon-floor2-01": "alarm",
        "notifier-shift-01": "notify",
        "conveyor-line2-01": "stop",
        "press-line2-01": "stop",
        "extraction-floor2-01": "turn_on",
        "lock-cell2-01": "unlock",
        "compressor-plant-01": "turn_off"
      },
      "_note": "Stop the line, purge the air, release the cell door for egress, shut the compressor, alarm and notify."
    },
    {
      "id": "N8",
      "env": "plant",
      "phrase": "The inspection is done. Restart line 2.",
      "expected": {
        "conveyor-line2-01": "turn_on"
      },
      "_note": "The press declares no turn_on; restarting it is not possible."
    },
    {
      "id": "N9",
      "env": "plant",
      "phrase": "The compressor is making a strange noise. Shut it off and let the shift know.",
      "expected": {
        "compressor-plant-01": "turn_off",
        "notifier-shift-01": "notify"
      }
    },
    {
      "id": "N10",
      "env": "plant",
      "phrase": "The air feels bad on floor 2. Check it and tell the shift.",
      "expected": {
        "sensor-particulate-01": "read_sensors",
        "notifier-shift-01": "notify"
      },
      "_note": "The particulate sensor measures air quality; the press temperature sensor does not."
    }
  ]
}
