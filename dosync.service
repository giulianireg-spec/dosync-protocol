# Template unit. Adjust WorkingDirectory, ExecStart, User and Group to
# your installation: /opt/dosync and the dosync user are conventions,
# not requirements. A unit file that carries one operator's home
# directory cannot be copied by anyone else.
[Unit]
Description=DoSync Hub
After=network.target
[Service]
Type=simple
User=dosync
WorkingDirectory=/opt/dosync
# Secrets do NOT belong in a unit file that ships with the project. This line
# carried a real Home Assistant long-lived token — issued May 2026, valid until
# 2036 — in a public repository, until a Windows persistence test happened to
# open the file. Keep credentials in a drop-in that is not tracked:
#
#   /etc/systemd/system/dosync.service.d/local.conf   (chmod 600)
#     [Service]
#     Environment="HA_URL=http://localhost:8123"
#     Environment="HA_TOKEN=..."
#
# systemd merges drop-ins over this unit, so nothing here needs editing.
ExecStart=/opt/dosync/venv/bin/uvicorn server:app \
  --host 0.0.0.0 \
  --port 47200 \
  --ssl-keyfile certs/hub.key \
  --ssl-certfile certs/hub.crt \
  --ssl-ca-certs certs/ca.crt \
  --ssl-cert-reqs 1
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
